---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, SOCIAL } from '../consts';
import { ORIGIN as BLYG_ORIGIN } from '../blyg/blyg';

interface Props {
  title?: string;
  description?: string;
  /** Open Graph image: absolute URL or site-root-relative path. */
  image?: string;
  /** For articles, emit <meta property="og:type" content="article"> */
  type?: 'website' | 'article';
  /** Article dates and tags, emitted as article:* Open Graph tags. */
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  /** Schema.org JSON-LD object(s) for this page. */
  jsonLd?: object | object[];
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Without a page image, share cards fall back to the site icon (small card).
const ogImage = new URL(image ?? '/apple-touch-icon.png', Astro.site).href;
// Escape "<" so post text can't close the <script> element early.
const jsonLdText = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={SITE.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/schibsted-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/podkova.woff2" as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <!-- Blygger discovery: href is the blyg origin, not the manifest (spec §12.1) -->
    <link rel="blyg" href={BLYG_ORIGIN} />
    <!-- Profile identity links (IndieWeb rel="me") -->
    {SOCIAL.map((s) => <link rel="me" href={s.href} />)}
    <slot name="head" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={SITE.author} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}

    <!-- Apply saved/system theme before paint to avoid a flash -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = saved ?? (prefersDark ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="site-main" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
