---
interface Props {
  date: Date;
}
const { date } = Astro.props;
const iso = date.toISOString();
const label = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  // Frontmatter dates are parsed as UTC midnight; don't shift them a day.
  timeZone: 'UTC',
});
---
<time datetime={iso}>{label}</time>
