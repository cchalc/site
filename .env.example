# Template for local secrets. Copy to `.env` and fill in real values.
# `.env` is gitignored; this file is committed as documentation.
# After editing `.env`, run `direnv allow` to load it.

# Cloudflare Pages / API (used by `wrangler` locally and documented for CI)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare R2 (S3-compatible) — only if/when you use R2 for assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=
