---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPublishedArticles } from '../../utils';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  // Newest first, so the older neighbour is i + 1 and the newer is i - 1.
  const link = (a?: (typeof articles)[number]) =>
    a && { href: `/articles/${a.id}/`, title: a.data.title };
  return articles.map((article, i) => ({
    params: { slug: article.id },
    props: { article, prev: link(articles[i + 1]), next: link(articles[i - 1]) },
  }));
}

const { article, prev, next } = Astro.props;
const { Content } = await render(article);
// Only published Markdown articles are on the blyg (see src/blyg/blyg.ts).
const onBlyg = !article.data.draft && !article.filePath?.endsWith('.mdx');
const imagePath =
  typeof article.data.image === 'string'
    ? article.data.image
    : article.data.image?.src;
---
<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  pubDate={article.data.pubDate}
  updatedDate={article.data.updatedDate}
  tags={article.data.tags}
  image={imagePath}
  prev={prev}
  next={next}
  blygId={onBlyg ? article.data.blygId : undefined}
>
  <Content />
</ArticleLayout>
