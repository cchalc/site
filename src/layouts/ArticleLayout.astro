---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  image?: string;
}
const { title, description, pubDate, updatedDate, tags = [], image } =
  Astro.props;
---
<BaseLayout title={title} description={description} image={image} type="article">
  <article>
    <header style="margin-bottom:2rem">
      <h1 style="margin-bottom:0.4rem">{title}</h1>
      <p class="muted" style="font-size:0.9rem;margin:0">
        <FormattedDate date={pubDate} />
        {updatedDate && <> · updated <FormattedDate date={updatedDate} /></>}
      </p>
      {tags.length > 0 && (
        <ul class="tag-row" style="margin-top:0.75rem">
          {tags.map((t) => (
            <li><a class="tag" href={`/tags/${t}/`}>#{t}</a></li>
          ))}
        </ul>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
  <p style="margin-top:3rem"><a href="/articles/">&larr; All articles</a></p>
</BaseLayout>
