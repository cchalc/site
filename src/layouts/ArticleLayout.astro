---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { ORIGIN as BLYG_ORIGIN } from '../blyg/blyg';

interface Neighbour {
  href: string;
  title: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  image?: string;
  /** Older article, if any. */
  prev?: Neighbour;
  /** Newer article, if any. */
  next?: Neighbour;
  /** Blygger item id, when this article is published on the blyg. */
  blygId?: string;
}
const { title, description, pubDate, updatedDate, tags = [], image, prev, next, blygId } =
  Astro.props;
---
<BaseLayout title={title} description={description} image={image} type="article">
  {blygId && (
    <link
      slot="head"
      rel="alternate"
      type="application/json"
      href={`${BLYG_ORIGIN}items/${blygId}.json`}
    />
  )}
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="post-meta">
        <FormattedDate date={pubDate} />
        {updatedDate && <span>updated <FormattedDate date={updatedDate} /></span>}
      </p>
      {tags.length > 0 && (
        <ul class="tag-row">
          {tags.map((t) => (
            <li><a class="tag" href={`/tags/${t}/`}>#{t}</a></li>
          ))}
        </ul>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
  {(prev || next) && (
    <nav class="nextprev" aria-label="More articles">
      {prev && (
        <a class="nextprev__prev" href={prev.href} rel="prev">
          <span class="nextprev__label">&larr; Older</span>
          <span class="nextprev__title">{prev.title}</span>
        </a>
      )}
      {next && (
        <a class="nextprev__next" href={next.href} rel="next">
          <span class="nextprev__label">Newer &rarr;</span>
          <span class="nextprev__title">{next.title}</span>
        </a>
      )}
    </nav>
  )}
  <p><a href="/articles/">&larr; All articles</a></p>
</BaseLayout>
