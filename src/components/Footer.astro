---
import { SITE, SOCIAL } from '../consts';
import SocialIcon from './SocialIcon.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <span>&copy; {year} {SITE.author}</span>
    <ul class="social" aria-label="Elsewhere">
      {SOCIAL.map((s) => (
        <li>
          <a href={s.href} rel="me noopener" aria-label={s.label} title={s.label}>
            <SocialIcon name={s.icon} />
          </a>
        </li>
      ))}
      <li>
        <a href="/rss.xml" aria-label="RSS feed" title="RSS feed"><SocialIcon name="rss" /></a>
      </li>
    </ul>
  </div>
</footer>
